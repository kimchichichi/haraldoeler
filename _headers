# Cloudflare Pages / Netlify-compatible headers.
# GitHub Pages ignores this file (forces max-age=600).
# Prefer Netlify/Cloudflare deploy or a CDN proxy for long-lived asset caching.
#
# Bundles/CSS are cache-busted via ?v= query strings in HTML — bump ?v= when rebuilding.

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/assets/*.bundle.js
  Cache-Control: public, max-age=31536000, immutable

/image/*
  Cache-Control: public, max-age=31536000, immutable

/news/image/*
  Cache-Control: public, max-age=31536000, immutable

/projekte/image/*
  Cache-Control: public, max-age=31536000, immutable

/*.css
  Cache-Control: public, max-age=31536000, immutable

/*.js
  Cache-Control: public, max-age=31536000, immutable

/*.webp
  Cache-Control: public, max-age=31536000, immutable

/*.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate
